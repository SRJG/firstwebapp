# Docker Compose 배포용 환경변수 예시 파일
#
# 사용법:
#   cp .env.docker.example .env
# 그 다음 이 파일을 열어서 실제 값(특히 비밀번호)으로 바꿔주세요.
# .env는 .gitignore에 이미 포함되어 있어서 git에는 올라가지 않습니다.
#
# ⚠️ 기존에 쓰던 로컬 개발용 .env(DB_HOST=192.168.1.21 등)와는 다른 파일입니다.
#    docker compose로 배포하는 서버에서는 DB_HOST/DB_PORT는 docker-compose.yml 안에서
#    자동으로 "db"/5432로 설정되므로 이 파일에 따로 적지 않아도 됩니다.

# Postgres 컨테이너용 계정 정보 (앱도 동일한 계정으로 접속함)
DB_USER=app_user
DB_PASSWORD=여기에_안전한_비밀번호를_입력하세요
DB_NAME=myapp_db

# 로그인 세션 암호화에 쓰이는 값. 무작위의 긴 문자열로 설정하세요.
# (예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 로 생성 가능)
SESSION_SECRET=여기에_무작위로_생성한_긴_문자열을_입력하세요

# 앱을 외부에 노출할 호스트 포트 (예: 3000이면 http://서버주소:3000 으로 접속)
APP_PORT=3000
